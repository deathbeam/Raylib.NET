<Project>
  <!-- The SDK infers RuntimeIdentifier (e.g. PublishAot without -r) after package props are imported -->
  <PropertyGroup>
    <RaylibStaticPath>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)../static/$(RuntimeIdentifier)/native/'))</RaylibStaticPath>
    <RaylibStaticLibrary Condition="$(RuntimeIdentifier.StartsWith('win-'))">$(RaylibStaticPath)raylib_static.lib</RaylibStaticLibrary>
    <RaylibStaticLibrary Condition="!$(RuntimeIdentifier.StartsWith('win-'))">$(RaylibStaticPath)libraylib.a</RaylibStaticLibrary>
  </PropertyGroup>

  <ItemGroup Condition="('$(PublishAot)' == 'true' Or '$(RuntimeIdentifier)' == 'browser-wasm') And Exists('$(RaylibStaticLibrary)')">
    <DirectPInvoke Include="raylib"/>
    <NativeLibrary Include="$(RaylibStaticLibrary)"/>
  </ItemGroup>

  <ItemGroup Condition="'$(PublishAot)' == 'true' And $(RuntimeIdentifier.StartsWith('win-')) And Exists('$(RaylibStaticLibrary)')">
    <NativeLibrary Include="opengl32.lib" />
    <NativeLibrary Include="gdi32.lib" />
    <NativeLibrary Include="winmm.lib" />
  </ItemGroup>

  <ItemGroup Condition="'$(PublishAot)' == 'true' And ('$(RuntimeIdentifier)' == 'osx-x64' Or '$(RuntimeIdentifier)' == 'osx-arm64')">
    <NativeFramework Include="Cocoa" />
    <NativeFramework Include="IOKit" />
    <NativeFramework Include="CoreFoundation" />
    <NativeFramework Include="OpenGL" />
    <NativeFramework Include="QuartzCore" />
  </ItemGroup>
</Project>
